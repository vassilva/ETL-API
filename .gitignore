# Environment variables / secrets
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Database dumps and backups
*.dump
*.backup
*.bak
*.sql.gz
*.sql.zip

# Power BI files (may embed data and connection details)
*.pbix
*.pbit

# Python virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Pytest
.pytest_cache/

# Lint cache
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Runtime ETL artifacts (rewritten by every 'python src/main.py' run).
# The versioned copy used by offline tests is tests/fixtures/snapshot/.
data/raw/
data/processed/
# Load freshness baseline (row versions captured before each Load)
data/state/

# Test reports (may contain assertion output)
reports/*
!reports/.gitkeep
junit*.xml
report*.html

# Logs
*.log
logs/

# IDE
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
