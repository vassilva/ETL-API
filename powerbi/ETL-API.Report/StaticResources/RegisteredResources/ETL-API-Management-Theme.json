{
  "name": "ETL-API Management",
  "dataColors": [
    "#1F3A5F",
    "#2A9D8F",
    "#8AA1B4",
    "#E9C46A",
    "#6C757D",
    "#264653",
    "#A8DADC",
    "#457B9D"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F3A5F",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#1F3A5F"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F2937"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F2937"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#6B7280"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 6
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
